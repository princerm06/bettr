{
  "name": "bettr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "benchmark:semantic:legacy": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-legacy.js",
    "benchmark:semantic:mobilebert": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-mobilebert.js",
    "benchmark:semantic:distilbert": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-distilbert.js",
    "dataset:semantic:developmental:emit": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/datasets/developmental-v1/emit-dataset.js",
    "dataset:semantic:developmental:audit": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/datasets/developmental-v1/audit-dataset.js",
    "benchmark:semantic:developmental:val": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-developmental-val.js 3a.2",
    "benchmark:semantic:developmental:3a.3": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-developmental-3a.3.js",
    "benchmark:semantic:developmental:3b": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-developmental-3b.js",
    "benchmark:semantic:developmental:4a": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-developmental-4a.js",
    "benchmark:semantic:developmental:5a": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-developmental-5a.js",
    "benchmark:semantic:developmental:3a-abstention": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-developmental-3a-abstention.js",
    "benchmark:semantic:developmental:3a-parity": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-3a-runtime-parity.js",
    "check:custom-composer-gate": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-custom-composer-gate-checks.js",
    "check:two-axis-production": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-two-axis-production-checks.js",
    "freeze:action-evidence-mpnet": "tsc --pretty false --strict --esModuleInterop --skipLibCheck --module commonjs --target ES2020 --moduleResolution node --outDir benchmarks/semantic/.compiled benchmarks/semantic/freeze-action-evidence-mpnet-weights.ts && node benchmarks/semantic/.compiled/benchmarks/semantic/freeze-action-evidence-mpnet-weights.js",
    "check:3a-fixture-parity": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-3a-fixture-parity.js",
    "check:category-suggestions": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-category-suggestion-fixtures.js",
    "check:priority-reward": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-priority-reward-checks.js",
    "check:priority-state": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-priority-state-checks.js",
    "check:edit-scoring": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-edit-scoring-checks.js",
    "check:discipline": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-discipline-checks.js",
    "check:progress-credit": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-progress-credit-checks.js",
    "check:category-taxonomy": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/semantic/run-category-taxonomy-checks.js",
    "check:planning-invariants": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/planning/run-planning-invariant-checks.js",
    "check:planning-schema": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/planning/run-planning-schema-checks.js",
    "check:planning-goals": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/planning/run-planning-goal-checks.js",
    "check:planning": "tsc -p tsconfig.benchmark.json && node benchmarks/semantic/.compiled/benchmarks/planning/run-planning-invariant-checks.js && node benchmarks/semantic/.compiled/benchmarks/planning/run-planning-schema-checks.js && node benchmarks/semantic/.compiled/benchmarks/planning/run-planning-goal-checks.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@xenova/transformers": "^2.17.2",
    "supabase": "^2.117.0",
    "typescript": "^5.7.2"
  }
}
