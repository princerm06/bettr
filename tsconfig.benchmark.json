{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "benchmarks/semantic/.compiled",
    "noEmit": false
  },
  "include": [
    "benchmarks/semantic/**/*.ts",
    "benchmarks/planning/**/*.ts",
    "benchmarks/social/**/*.ts",
    "lib/evaluation/**/*.ts",
    "lib/planning/**/*.ts",
    "lib/plannerExecution/**/*.ts",
    "lib/calendar/**/*.ts",
    "benchmarks/calendar/**/*.ts"
  ]
}
